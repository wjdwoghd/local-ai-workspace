# Server only. Copy to apps/server/.env and fill locally. Never distribute with desktop.
OPENAI_API_KEY=
# DB-free local API server; select only a documented model available to your account.
OPENAI_MODEL_ID=gpt-6.1-sol
OPENAI_MODEL_LABEL=GPT-6.1 Sol
OPENAI_ASTRA_MODEL_ID=gpt-6-astra
# Built-in choices: GPT-6.1 Sol (default) and Astra. Optional extra models require official
# Responses/streaming support verification and account access. No silent fallback.
OPENAI_ADDITIONAL_MODELS=[]
# Legacy Oracle-backed server mode only; ignored by start:local.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=
SESSION_SECRET=
SESSION_MINUTES=480
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
HTTPS_PROXY_CONFIRMED=false
# Optional integration tests: dedicated empty schema ONLY, separate from ORACLE_USER.
TEST_ORACLE_USER=
TEST_ORACLE_PASSWORD=
TEST_ORACLE_CONNECT_STRING=
TEST_ORACLE_CONFIRM_SCHEMA=
