{
  "name": "@local-ai-workspace/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "한국어 로컬 AI 워크스페이스 데모",
  "author": "Local AI Workspace",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
